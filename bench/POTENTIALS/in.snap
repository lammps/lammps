# bulk W via SNAP (2J=8) plus ZBL

units		metal
atom_style	atomic

lattice		bcc 3.1803
region		box block 0 20 0 20 0 20
create_box	1 box
create_atoms	1 box
mass		1 183.84

pair_style	hybrid/overlay zbl 4.0 4.8 snap
pair_coeff	1 1 zbl 74 74
pair_coeff	* * snap W_2940_2017_2.snapcoeff W_2940_2017_2.snapparam W

velocity	all create 300.0 4928459 loop geom

neighbor	1.0 bin
neigh_modify    delay 0 every 1

fix		1 all nve

timestep	0.0005

run		100

# Performance benchmark: BPM peridynamics (pair_style + bond_style bpm/peri, pmb).
# Same 16^3 block and run protocol as in.bench.legacy.pmb, for a like-for-like
# per-step force-cost comparison.  Vary the model by editing the bond_coeff line.

units           si
boundary        p p p
atom_style      bond
atom_modify     map array
special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0
newton          on off
neighbor        0.0005 bin
comm_modify     cutoff 0.004
lattice         sc 0.0005
region          box block 0 16 0 16 0 16 units lattice
create_box      1 box bond/types 1 extra/bond/per/atom 200 extra/special/per/atom 250
create_atoms    1 box
mass            * 2.75e-7
fix             vol all property/atom d_vfrac ghost yes
set             group all d_vfrac 1.25e-10

pair_style      bpm/peri
pair_coeff      * * 1.6863e22 0.0015001
create_bonds    many all all 1 0.0 0.0015001
special_bonds   lj 0.0 1.0 1.0 coul 1.0 1.0 1.0
bond_style      bpm/peri
bond_coeff      1 pmb 1.6863e22 0.0015001 0.5 0.25

velocity        all set 0.0 0.0 0.0 units box
fix             1 all nve
timestep        1.0e-7
thermo          100
run             200

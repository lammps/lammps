# bcc iron in a inertial spin dynamics simulation (NVE)
#
# The spin modulus is a dynamical degree of freedom here, so the run needs a
# longitudinal potential on the modulus (fix spring/tspin) in addition to the
# usual magnetic interactions.  The sum pe + f_pin + c_ske is conserved.

units           metal
dimension       3
boundary        p p p
atom_style      tspin

# necessary for the serial algorithm (sametag)
atom_modify     map array

lattice         bcc 2.8665
Lattice spacing in x,y,z = 2.8665 2.8665 2.8665
region          box block 0.0 4.0 0.0 4.0 0.0 4.0
create_box      1 box
Created orthogonal box = (0 0 0) to (11.466 11.466 11.466)
  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 128 atoms
  using lattice units in orthogonal box = (0 0 0) to (11.466 11.466 11.466)
  create_atoms CPU = 0.001 seconds

# setting mass, mag. moments, and interactions for bcc iron

mass            1 55.845
set             group all spin/atom/random 31 2.2
Setting atom values ...
  128 settings made for spin/atom/random

pair_style      spin/exchange 3.5
pair_coeff      * * exchange 3.4 0.02726 0.2171 1.841

neighbor        0.1 bin
neigh_modify    every 10 check yes delay 20

# longitudinal potential on the spin modulus (required for inertial dynamics)

fix             pin all spring/tspin 1.0 2.2

# inertial spin dynamics on a frozen lattice, spin mass = 0.0075 * atomic mass

fix             1 all nve/tspin lattice frozen spinmass 0.0075

timestep        0.0001

compute         out_mag all spin
compute         ske all ke/tspin

variable        magnorm equal c_out_mag[4]
variable        emag    equal c_out_mag[5]
variable        etot    equal pe+f_pin+c_ske

thermo          200
thermo_style    custom step time v_magnorm pe f_pin c_ske v_etot
thermo_modify   format float %20.15g

run             2000

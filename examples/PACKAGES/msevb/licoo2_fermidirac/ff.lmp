##############################################################################################
#### Atoms' types - mass - charge
##############################################################################################
#@ 6   atom types

variable Li  equal 1
variable Co2 equal 2
variable Co3 equal 3 
variable Co4 equal 4
variable O   equal 5
variable Co1 equal 6

##############################################################################################
#### Atoms' masses
##############################################################################################

mass  ${Li}    6.941 
mass  ${Co2}  58.933 
mass  ${Co3}  58.933 
mass  ${Co4}  58.933 
mass  ${O}    15.996
mass  ${Co1}  58.933 

##############################################################################################
#### Atoms' charges
##############################################################################################

set type ${Li}   charge     0.600000 
set type ${Co2}  charge     1.200000 
set type ${Co3}  charge     1.800000 
set type ${Co4}  charge     2.400000
set type ${O}    charge    -1.200000 
set type ${Co1}  charge     1.800000 

##############################################################################################
#### Covalent bonds parameters                                                                
##############################################################################################
#@  0   bond types

##############################################################################################
# Pair potentials                                                                             
##############################################################################################

variable rmin  equal  12.
variable rmax  equal  15.

pair_style hybrid/overlay buck/mdf ${rmin} ${rmax} coul/long ${rmax}

##############################################################################################
# Buckingham interaction potentials
pair_coeff  ${Li}  ${O}  buck/mdf   12120.826 0.176020 1.6624   
pair_coeff  ${Co2} ${O}  buck/mdf   12500.558 0.207446 33.934   
pair_coeff  ${Co3} ${O}  buck/mdf   34015.346 0.192977 105.94   
pair_coeff  ${Co4} ${O}  buck/mdf   23801.309 0.168706 10.602   
pair_coeff  ${O}   ${O}  buck/mdf   1844.7458 0.343645 192.58   
pair_coeff  ${Co1} ${O}  buck/mdf   34015.346 0.192977 105.94   

##############################################################################################
# Coulombic interaction
pair_coeff      *      *  coul/long

#########################################################################################################
# Parameters for reciprocal space electrostatics
#########################################################################################################

kspace_style pppm 1.0e-5
kspace_modify fftbench no 
# kspace_modify gewald 0.3

# Rigid-body test: a grid of 8-atom rigid cubes
# Reduced version of the system used to validate fix rigid/small/kk.
# Run the non-Kokkos and Kokkos versions and compare the thermo output:
#   lmp -in in.rigid.cubes
#   lmp -k on -sf kk -in in.rigid.cubes
# (data.rigid.cubes is produced by gen_cubes.py)

units           lj
atom_style      molecular
atom_modify     map array

read_data       data.rigid.cubes

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0

# rigid bodies do not feel internal forces; exclude intra-body neighbor pairs
neigh_modify    exclude molecule/intra all

velocity        all create 1.5 4928459 mom yes rot yes

fix             1 all rigid/nph/small molecule iso 1.0 1.0 5.0

thermo_style    custom step temp pe ke etotal press vol
thermo          200
timestep        0.0005
run             4000

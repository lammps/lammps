# heap of 3d rounded polyhedron bodies with the contact models of the
# GRANULAR package
#
# as in.heap3d, cubes and tetrahedra are poured onto the floor, where they
# come to rest in a heap, and then gravity is tilted by 20 degrees.  Here
# the contacts between the bodies use the sub-models of pair style granular:
# a Hertzian normal force from the elastic properties of each body type,
# mixed for contacts between cubes and tetrahedra, a damping proportional to
# the effective mass, and a tangential spring with the contact history,
# whose static friction keeps the tilted heap at rest (tan 20 degrees < mu),
# as the x coordinate of its center of mass (v_xcm) shows.  The floor uses
# the same contact models with fix wall/body/polyhedron/granular.
# The stiffness E is chosen so that the normal force at an overlap of 0.05
# at a vertex is about that of k_n = 100 in in.heap3d.

variable    steps       index 10000
variable    steps_tilt  index 10000
variable    tilt        index 20.0

units       lj
boundary    p p fm
comm_modify vel yes

atom_style  body rounded/polyhedron 1 8
atom_modify map array

region      reg block 0 20 0 20 0 40 units box
create_box  2 reg
Created orthogonal box = (0 0 0) to (20 20 40)
  1 by 1 by 1 MPI processor grid

variable cut_inner  equal 0.5
variable A_ua       equal 1
variable k_na       equal 1
variable damp       equal 20
variable k_t        equal 30
variable xt         equal 0.25
variable mu         equal 0.5

# type 1 = cubes, type 2 = tetrahedra, the coefficients of
# cube-tetrahedron contacts are mixed

pair_style body/rounded/polyhedron/granular ${A_ua} ${cut_inner}
pair_style body/rounded/polyhedron/granular 1 ${cut_inner}
pair_style body/rounded/polyhedron/granular 1 0.5
pair_coeff 1 1 hertz/material 1200 ${damp} 0.3 damping mass_velocity            tangential linear_history ${k_t} ${xt} ${mu} cohesion ${k_na}
pair_coeff 1 1 hertz/material 1200 20 0.3 damping mass_velocity            tangential linear_history ${k_t} ${xt} ${mu} cohesion ${k_na}
pair_coeff 1 1 hertz/material 1200 20 0.3 damping mass_velocity            tangential linear_history 30 ${xt} ${mu} cohesion ${k_na}
pair_coeff 1 1 hertz/material 1200 20 0.3 damping mass_velocity            tangential linear_history 30 0.25 ${mu} cohesion ${k_na}
pair_coeff 1 1 hertz/material 1200 20 0.3 damping mass_velocity            tangential linear_history 30 0.25 0.5 cohesion ${k_na}
pair_coeff 1 1 hertz/material 1200 20 0.3 damping mass_velocity            tangential linear_history 30 0.25 0.5 cohesion 1
pair_coeff 2 2 hertz/material 800 ${damp} 0.25 damping mass_velocity            tangential linear_history ${k_t} ${xt} ${mu} cohesion ${k_na}
pair_coeff 2 2 hertz/material 800 20 0.25 damping mass_velocity            tangential linear_history ${k_t} ${xt} ${mu} cohesion ${k_na}
pair_coeff 2 2 hertz/material 800 20 0.25 damping mass_velocity            tangential linear_history 30 ${xt} ${mu} cohesion ${k_na}
pair_coeff 2 2 hertz/material 800 20 0.25 damping mass_velocity            tangential linear_history 30 0.25 ${mu} cohesion ${k_na}
pair_coeff 2 2 hertz/material 800 20 0.25 damping mass_velocity            tangential linear_history 30 0.25 0.5 cohesion ${k_na}
pair_coeff 2 2 hertz/material 800 20 0.25 damping mass_velocity            tangential linear_history 30 0.25 0.5 cohesion 1

neighbor     0.5 bin
neigh_modify every 1 delay 0 check yes

timestep     0.002

fix          1 all nve/body
fix          2 all gravity 1.0 vector 0.0 0.0 -1.0

molecule     object molecule.cube molecule.tetra toff 1
Read molecule template object:
# 3d polygon body: cubes, moment of inertia I = m edge^2/ 6
  1 molecules
  0 fragments
  1 bodies
  1 atoms with max type 1
  0 bonds with max type 0
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0
Read molecule template object:
# 3d polygon body: regular tetrahedra, moment of inertia I = m edge^2/ 20
  1 molecules
  0 fragments
  1 bodies
  1 atoms with max type 2
  0 bonds with max type 0
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0
region       slab block 2 18 2 18 4 20 units box

fix          ins all pour 50 0 4767548 vol 0.25 10 region slab mol object              molfrac 0.5 0.5

# the floor has the elastic properties and friction of the cubes

fix          4 all wall/body/polyhedron/granular hertz/material 1200 ${damp} 0.3              damping mass_velocity tangential linear_history ${k_t} ${xt} ${mu}              zplane 0.0 NULL
fix          4 all wall/body/polyhedron/granular hertz/material 1200 20 0.3              damping mass_velocity tangential linear_history ${k_t} ${xt} ${mu}              zplane 0.0 NULL
fix          4 all wall/body/polyhedron/granular hertz/material 1200 20 0.3              damping mass_velocity tangential linear_history 30 ${xt} ${mu}              zplane 0.0 NULL
fix          4 all wall/body/polyhedron/granular hertz/material 1200 20 0.3              damping mass_velocity tangential linear_history 30 0.25 ${mu}              zplane 0.0 NULL
fix          4 all wall/body/polyhedron/granular hertz/material 1200 20 0.3              damping mass_velocity tangential linear_history 30 0.25 0.5              zplane 0.0 NULL

compute      tb all temp/body
compute_modify thermo_temp dynamic/dof yes
compute_modify tb dynamic/dof yes
variable     xcm equal xcm(all,x)
thermo_style custom step atoms ke c_tb pe v_xcm
thermo_modify norm yes
thermo       1000

#dump         2 all image 1000 image.*.jpg type type body type 0.05 3 #             fix 4 type 0 0 view 75 15 center s 0.5 0.5 0.3 zoom 1.4 box no 0.0
#dump_modify  2 pad 6

run          ${steps}
run          10000

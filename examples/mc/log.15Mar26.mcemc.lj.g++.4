# MCEMC for LJ simple fluid, no dynamics

# Variables modifiable using -var command line switch
# temp:   reservoir temperature
# disp:   maximum displacement for MC moves
# lbox:   simulation box size
# ntotal: total number of particles (Ngauge + Nsimulation)
# vgauge: volume of gauge cell

variable        temp    equal 2.0       # reservoir temperature
variable        disp    equal 1.0       # maximum displacement
variable        lbox    equal 5.0       # box size
variable        ntotal  equal 80        # total particles (Ngauge + Nsimulation)
variable        vgauge  equal 1200      # volume of gauge cell

# Global model settings

units           lj
atom_style      atomic
pair_style      lj/cut 3.0
pair_modify     tail no        # turn off to avoid triggering full_energy

# Box setup

region          box block 0 ${lbox} 0 ${lbox} 0 ${lbox}
region          box block 0 5 0 ${lbox} 0 ${lbox}
region          box block 0 5 0 5 0 ${lbox}
region          box block 0 5 0 5 0 5
create_box      1 box
Created orthogonal box = (0 0 0) to (5 5 5)
  1 by 2 by 2 MPI processor grid

# Lennard-Jones parameters

pair_coeff      * * 1.0 1.0          # LJ epsilon=1.0, sigma=1.0
mass            1 1.0                 # mass for type 1

# Setup dedicated group for MCEMC

group           mcemcgroup type 1
0 atoms in group mcemcgroup

# GCMC fix with mcemc keyword
fix             mymcemc mcemcgroup gcmc 1 100 100 1 1234 ${temp} 0.0 ${disp} mcemc ${ntotal} ${vgauge}
fix             mymcemc mcemcgroup gcmc 1 100 100 1 1234 2 0.0 ${disp} mcemc ${ntotal} ${vgauge}
fix             mymcemc mcemcgroup gcmc 1 100 100 1 1234 2 0.0 1 mcemc ${ntotal} ${vgauge}
fix             mymcemc mcemcgroup gcmc 1 100 100 1 1234 2 0.0 1 mcemc 80 ${vgauge}
fix             mymcemc mcemcgroup gcmc 1 100 100 1 1234 2 0.0 1 mcemc 80 1200

# atom count

variable        type1 atom "type==1"
group           type1 dynamic mcemcgroup var type1
dynamic group type1 defined
variable        nsimulation equal count(type1)
variable        ngauge equal ${ntotal}-v_nsimulation
variable        ngauge equal 80-v_nsimulation
variable        volgauge equal ${vgauge}
variable        volgauge equal 1200

# averaging
fix             ave all ave/time 1 100 100 v_nsimulation v_ngauge v_volgauge ave one file mcemc_output.dat

compute_modify  thermo_temp dynamic/dof yes

thermo_style    custom step atoms v_nsimulation v_ngauge temp press pe ke etotal
thermo          100

run             10000


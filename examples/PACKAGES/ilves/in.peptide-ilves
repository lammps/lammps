# Solvated 5-mer peptide -- ILVES constraint solver
# (mirror of examples/peptide/in.peptide using fix ilves)

units           real
atom_style      full

pair_style      lj/charmm/coul/long 8.0 10.0 10.0
bond_style      harmonic
angle_style     charmm
dihedral_style  charmm
improper_style  harmonic
kspace_style    pppm 0.0001

read_data       ../../peptide/data.peptide

neighbor        2.0 bin
neigh_modify    delay 5

timestep        2.0

thermo_style    multi
thermo          50

fix             1 all nvt temp 275.0 275.0 100.0 tchain 1

# constrain all hydrogen-containing bonds + the water HOH angle (matches
# the fix shake invocation in examples/peptide/in.peptide).  Works
# correctly across MPI ranks for both newton on and newton off; the
# default 'ilves' variant uses the symmetric Jacobian, 'ilvesf' uses the
# exact (structurally-symmetric) Newton Jacobian.
fix             cstr all ilves 0.0001 10 100 b 4 6 8 10 12 14 18 a 31

run             300

# fix symmetry example: 8 LJ atoms with inversion symmetry (space group P-1)
#
# Four atoms are placed in one half of the box and their images under
# inversion through the origin of the box in the other half.  Without
# perturbations, plain MD would keep this symmetry, since the forces
# are symmetric.  But tiny deviations from perfect symmetry, e.g. from
# round-off errors, grow exponentially and destroy the symmetry.
#
# The first run with fix symmetry keeps the symmetry exactly.  For the
# second run, the fix is removed and one atom is displaced by 1.0e-4.
# The deviation from symmetry, shown in the last thermo column, grows by
# five orders of magnitude within a few thousand steps.  Round-off errors
# of about 1.0e-16 have the same effect, only it takes longer and the
# result depends on the platform and the number of MPI processes.

units           lj
atom_style      atomic
boundary        p p p

region          box block 0 8 0 8 0 8
create_box      1 box

# four atoms and their images at -x, -y, -z, i.e. 8 - x, 8 - y, 8 - z
create_atoms    1 single 1.2 1.5 1.8
create_atoms    1 single 3.0 1.2 0.9
create_atoms    1 single 1.5 3.0 1.1
create_atoms    1 single 0.9 1.1 3.2
create_atoms    1 single 6.8 6.5 6.2
create_atoms    1 single 5.0 6.8 7.1
create_atoms    1 single 6.5 5.0 6.9
create_atoms    1 single 7.1 6.9 4.8

mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
pair_modify     shift yes

fix             1 all nve
fix             sym all symmetry p-1.json

# random velocities are not symmetric.  "run 0" makes them symmetric,
# which removes about half of the kinetic energy, so the velocities are
# rescaled afterwards.  The temperature only counts the degrees of
# freedom left by the symmetry: here 3 for each of the 4 atom pairs.
velocity        all create 0.7 12345 mom yes rot yes
run             0 post no
velocity        all scale 0.7

# symmetry indicator: the sum of sin(2*pi*s) over the fractional
# coordinates s of all atoms vanishes for an inversion symmetric
# configuration, since the terms of an atom and its image cancel
variable        odd atom sin(2*PI*(x-xlo)/lx)+sin(2*PI*(y-ylo)/ly)+sin(2*PI*(z-zlo)/lz)
compute         odd all reduce sum v_odd

thermo_style    custom step temp pe etotal press c_odd
thermo          1000
run             2000

# continue without fix symmetry after a tiny displacement of atom 1
unfix           sym
group           one id 1
displace_atoms  one move 1.0e-4 0.0 0.0
run             6000

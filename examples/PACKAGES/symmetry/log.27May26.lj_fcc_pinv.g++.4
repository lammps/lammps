# Adapted from examples/melt/in.melt -- 256-atom LJ FCC crystal constrained
# to P-1 (inversion through the cell origin) by fix symmetry. Demonstrates
# the fix on a representative crystalline system, including 124 general
# inversion pairs and 8 Wyckoff atoms sitting on inversion centers.
#
# The companion files data.fcc_pinv and fcc_pinv.json are produced by the
# helper script generate_fcc_pinv.py. Re-run it to scale the system to
# different (nx, ny, nz) or lattice parameter.

units           lj
atom_style      atomic
atom_modify     map array

read_data       data.fcc_pinv
Reading data file ...
  orthogonal box = (0 0 0) to (6.3496 6.3496 6.3496)
  1 by 2 by 2 MPI processor grid
  reading atoms ...
  256 atoms
  read_data CPU = 0.001 seconds

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

velocity        all create 1.5 87287 loop geom

fix             1 all nve
fix             sym all symmetry fcc_pinv.json

thermo          50
thermo_style    custom step temp pe etotal press

# Sanity check via two representative orbits: a general pair (tags 2 and
# 62 are inversion-related per fcc_pinv.json) and a Wyckoff atom (tag 1
# at the cell origin, fixed by the inversion).
#
# For each component k, (x_asym + x_image) / L must be an integer at every
# step -- the integer captures the periodic image the user placed the pair
# in initially. Drift away from an integer would indicate symmetry breaking.
variable        modx  equal (x[2]+x[62])/lx-round((x[2]+x[62])/lx)
variable        mody  equal (y[2]+y[62])/ly-round((y[2]+y[62])/ly)
variable        modz  equal (z[2]+z[62])/lz-round((z[2]+z[62])/lz)
variable        wy1x  equal x[1]
variable        wy1y  equal y[1]
variable        wy1z  equal z[1]

print           "pre-run  pair residual=(${modx},${mody},${modz})  Wyckoff atom 1=(${wy1x},${wy1y},${wy1z})"
pre-run  pair residual=(2.22044604925031e-16,2.22044604925031e-16,0)  Wyckoff atom 1=(0,0,0)
run             250


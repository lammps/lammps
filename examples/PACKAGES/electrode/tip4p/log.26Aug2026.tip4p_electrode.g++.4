     1 = max # of 1-3 neighbors
     1 = max # of 1-4 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.001 seconds
  read_data CPU = 0.022 seconds


# ----------------------------------------------------------------------
# Force field
# ----------------------------------------------------------------------

pair_style      lj/cut/tip4p/long 1 2 1 1 0.1546 8.0 8.0


# ----------------------------------------------------------------------
# TIP4P water
# ----------------------------------------------------------------------

pair_coeff      1 1 0.1852 3.1589   # O-O
pair_coeff      1 2 0.0    0.0      # O-H
pair_coeff      2 2 0.0    0.0      # H-H


# ----------------------------------------------------------------------
# Graphene electrodes
# ----------------------------------------------------------------------

pair_coeff      3 3 0.085842 3.40    # C-C
pair_coeff      4 4 0.085842 3.40    # C-C
pair_coeff      3 4 0.085842 3.40    # C-C


# ----------------------------------------------------------------------
# Water - graphene
# ----------------------------------------------------------------------

pair_coeff      1 3 0.1261 3.27945  # O-C
pair_coeff      1 4 0.1261 3.27945  # O-C
pair_coeff      2 3 0.0    1.6      # H-C
pair_coeff      2 4 0.0    1.6      # H-C


# ----------------------------------------------------------------------
# Neighbor list
# ----------------------------------------------------------------------

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes


# ----------------------------------------------------------------------
# Long-range electrostatics
# ----------------------------------------------------------------------

kspace_style    pppm/electrode/tip4p 1.0e-4
kspace_modify   slab 3.0
Updated KSpace settings:
  KSpace computation is turned:    ON
  Use MPI collective operations:   OFF
  Use MPI non-blocking operations: OFF
  Gewald is determined automatically
  Slab volfactor manually set to:    3


# ----------------------------------------------------------------------
# Groups
# ----------------------------------------------------------------------

group           water type 1 2
300 atoms in group water

group           GL type 3
180 atoms in group GL
group           GH type 4
180 atoms in group GH
group           G union GL GH
360 atoms in group G


# ----------------------------------------------------------------------
# Initial velocities
# ----------------------------------------------------------------------

velocity        water create 300.0 492845 mom yes rot yes dist gaussian loop geom


# ----------------------------------------------------------------------
# Constraints and dynamics
# ----------------------------------------------------------------------

fix             freeze G setforce 0.0 0.0 0.0

fix             shake water shake 1.0e-4 20 0 b 1 a 1
Finding SHAKE clusters ...
       0 = # of size 2 clusters
       0 = # of size 3 clusters
       0 = # of size 4 clusters
     100 = # of frozen angles
  find clusters CPU = 0.000 seconds

fix             nvt water nvt temp 300.0 300.0 100.0


# ----------------------------------------------------------------------
# Constant-potential electrodes
#
# The two graphene electrodes are maintained at -0.25 V and +0.25 V.
# ----------------------------------------------------------------------

fix             conp GL electrode/conp -0.25 1.805 couple GH 0.25 symm on
360 atoms in group conp_group


# ----------------------------------------------------------------------
# Electrode charge diagnostics
# ----------------------------------------------------------------------

compute         q_atom G property/atom q

compute         q_GL GL reduce sum c_q_atom
compute         q_GH GH reduce sum c_q_atom

variable        Q_GL equal c_q_GL
variable        Q_GH equal c_q_GH
variable        Q_total equal c_q_GL+c_q_GH

# Absolute charge magnitude on each electrode

variable        q_abs atom abs(c_q_atom)

compute         qabs_GL GL reduce sum v_q_abs
compute         qabs_GH GH reduce sum v_q_abs

# Maximum and minimum atomic charges on the electrodes

compute         qmax_G G reduce max c_q_atom
compute         qmin_G G reduce min c_q_atom


# ----------------------------------------------------------------------
# Thermodynamic output
# ----------------------------------------------------------------------

thermo          10

thermo_style    custom step temp pe ecoul elong etotal press v_Q_GL v_Q_GH v_Q_total c_qabs_GL c_qabs_GH c_qmax_G c_qmin_G


# ----------------------------------------------------------------------
# Demonstration run
# ----------------------------------------------------------------------

run             100


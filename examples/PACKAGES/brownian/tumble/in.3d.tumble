# 3d run-and-tumble particles: overdamped translation, self-propulsion along
# the dipole vector, random reorientation with a Poisson rate, WCA repulsion

variable        temp equal 0.1       # sets the translational diffusion D_t = temp/gamma_t
variable        gamma_t equal 10.0
variable        fp equal 10.0        # self-propulsion speed v0 = fp/gamma_t = 1.0
variable        rate equal 0.5       # tumble rate, mean run length = v0/rate = 2.0
variable        seed equal 12345

units           lj
dimension       3
atom_style      dipole
newton          off

lattice         sc 0.2
region          box block 0 8 0 8 0 8
create_box      1 box
create_atoms    1 box
mass            * 1.0
set             group all dipole/random ${seed} 1.0

# WCA potential (purely repulsive)
pair_style      lj/cut 1.122462
pair_coeff      * * 1.0 1.0
pair_modify     shift yes
neigh_modify    every 1 delay 0 check yes

fix             step all brownian ${temp} ${seed} gamma_t ${gamma_t}
fix             prop all propel/self dipole ${fp}
fix             tumb all tumble dipole ${rate} ${seed}

# orientation autocorrelation <e(t).e(0)> (should decay as exp(-rate*t))
# and mean squared displacement
compute         mu all property/atom mux muy muz
fix             mu0 all store/state 0 c_mu[1] c_mu[2] c_mu[3]
variable        ecorr atom c_mu[1]*f_mu0[1]+c_mu[2]*f_mu0[2]+c_mu[3]*f_mu0[3]
compute         ecorr all reduce ave v_ecorr
compute         msd all msd
compute         press all pressure NULL virial

thermo_style    custom step time pe c_ecorr c_msd[4] c_press
thermo_modify   norm no
thermo          500
timestep        0.002

run             10000

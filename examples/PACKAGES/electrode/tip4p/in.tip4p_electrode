echo both

# ======================================================================
# Example:
# TIP4P water with constant-potential graphene electrodes
#
# This test exercises:
#
#   * lj/cut/tip4p/long for TIP4P water
#   * lj/cut/tip4p/long for water-graphene interactions
#   * lj/cut/coul/long for graphene-graphene interactions
#   * pppm/electrode/tip4p for long-range electrostatics
#   * fix electrode/conp for constant-potential electrodes
#
# IMPORTANT:
#
# This input intentionally uses PairHybrid with a TIP4P sub-style and
# another sub-style containing Coulomb interactions.
#
# LAMMPS may therefore print the warning:
#
#   "Using a tip4p sub-style with other sub-styles that include coulomb
#    interactions can result in inconsistent calculation of the
#    coulomb interactions"
#
# This warning is generated by the standard LAMMPS PairHybrid code and
# is NOT introduced by the TIP4P/ELECTRODE modifications being tested
# here.
#
# Consequently, the presence of this warning is expected for this
# example and must not be interpreted as a regression failure.
#
# The purpose of this test is instead to verify that:
#
#   1. TIP4P parameters are correctly extracted.
#   2. pppm/electrode/tip4p initializes correctly.
#   3. TIP4P charge mapping works correctly.
#   4. fix electrode/conp initializes and operates correctly.
#   5. The simulation can proceed without an ERROR.
#
# System:
#
#   * TIP4P water
#   * two parallel graphene electrodes
#   * 20 Angstrom electrode separation
#   * constant potentials of -0.25 V and +0.25 V
#
# Data file:
#
#   data.tip4p_electrode_graphene
#
# ======================================================================

units           real
dimension       3
boundary        p p p

atom_style      full


# ----------------------------------------------------------------------
# Molecular topology
# ----------------------------------------------------------------------

bond_style      harmonic
angle_style     harmonic


# ----------------------------------------------------------------------
# System
#
# Atom types:
#
#   1 : TIP4P oxygen
#   2 : TIP4P hydrogen
#   3 : graphene electrode 1
#   4 : graphene electrode 2
#
# The two graphene electrodes are separated by 20 Angstrom.
# ----------------------------------------------------------------------

read_data       data.tip4p_electrode_graphene


# ----------------------------------------------------------------------
# Hybrid force field
#
# TIP4P water and water-graphene interactions:
#   lj/cut/tip4p/long
#
# Graphene-graphene interactions:
#   lj/cut/coul/long
# ----------------------------------------------------------------------

pair_style      hybrid lj/cut/coul/long 8.0 8.0 lj/cut/tip4p/long 1 2 1 1 0.1546 8.0 8.0


# ----------------------------------------------------------------------
# TIP4P water
# ----------------------------------------------------------------------

pair_coeff      1 1 lj/cut/tip4p/long 0.1852 3.1589   # O-O
pair_coeff      1 2 lj/cut/tip4p/long 0.0    0.0      # O-H
pair_coeff      2 2 lj/cut/tip4p/long 0.0    0.0      # H-H


# ----------------------------------------------------------------------
# Graphene electrodes
# ----------------------------------------------------------------------

pair_coeff      3 3 lj/cut/coul/long 0.085842 3.40    # C-C
pair_coeff      4 4 lj/cut/coul/long 0.085842 3.40    # C-C
pair_coeff      3 4 lj/cut/coul/long 0.085842 3.40    # C-C


# ----------------------------------------------------------------------
# Water - graphene
# ----------------------------------------------------------------------

pair_coeff      1 3 lj/cut/tip4p/long 0.1261 3.27945  # O-C
pair_coeff      1 4 lj/cut/tip4p/long 0.1261 3.27945  # O-C
pair_coeff      2 3 lj/cut/tip4p/long 0.0    1.6      # H-C
pair_coeff      2 4 lj/cut/tip4p/long 0.0    1.6      # H-C


# ----------------------------------------------------------------------
# Neighbor list
# ----------------------------------------------------------------------

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes


# ----------------------------------------------------------------------
# Long-range electrostatics
# ----------------------------------------------------------------------

kspace_style    pppm/electrode/tip4p 1.0e-4

# ----------------------------------------------------------------------
# Groups
# ----------------------------------------------------------------------

group           water type 1 2

group           GL type 3
group           GH type 4
group           G union GL GH


# ----------------------------------------------------------------------
# Initial velocities
# ----------------------------------------------------------------------

velocity        water create 300.0 492845 mom yes rot yes dist gaussian


# ----------------------------------------------------------------------
# Constraints and dynamics
# ----------------------------------------------------------------------

fix             freeze G setforce 0.0 0.0 0.0

fix             shake water shake 1.0e-4 20 0 b 1 a 1

fix             nvt water nvt temp 300.0 300.0 100.0


# ----------------------------------------------------------------------
# Constant-potential electrodes
#
# The two graphene electrodes are maintained at -0.25 V and +0.25 V.
# ----------------------------------------------------------------------

fix             conp GL electrode/conp -0.25 1.805 couple GH 0.25 symm on


# ----------------------------------------------------------------------
# Electrode charge diagnostics
# ----------------------------------------------------------------------

compute         q_atom G property/atom q

compute         q_GL GL reduce sum c_q_atom
compute         q_GH GH reduce sum c_q_atom

variable        Q_GL equal c_q_GL
variable        Q_GH equal c_q_GH
variable        Q_total equal c_q_GL+c_q_GH

# Absolute charge magnitude on each electrode

variable        q_abs atom abs(c_q_atom)

compute         qabs_GL GL reduce sum v_q_abs
compute         qabs_GH GH reduce sum v_q_abs

# Maximum and minimum atomic charges on the electrodes

compute         qmax_G G reduce max c_q_atom
compute         qmin_G G reduce min c_q_atom



# Thermodynamic output
# ----------------------------------------------------------------------

thermo          10

thermo_style    custom step temp pe ecoul elong etotal press v_Q_GL v_Q_GH v_Q_total c_qabs_GL c_qabs_GH c_qmax_G c_qmin_G
# ----------------------------------------------------------------------

# ----------------------------------------------------------------------
# Demonstration run
# ----------------------------------------------------------------------

run             100

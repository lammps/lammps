pair_style body/rounded/polyhedron 20 5 0 ${A_ua} ${cut_inner}
pair_style body/rounded/polyhedron 20 5 0 1 ${cut_inner}
pair_style body/rounded/polyhedron 20 5 0 1 0.5
pair_coeff * * ${k_n} ${k_na}

# Peridynamics (VES model) on the BPM framework: a small brittle cylinder
# shattered by a spherical indenter.  Equivalent to examples/peri/in.peri.ves
# but using atom_style bond + bond_style/pair_style bpm/peri.
#
# Fragmentation note: when the target shatters, fragments can leave the domain.
# The legacy PERI package tolerates such lost atoms silently; in the BPM
# framework this is opt-in via thermo_modify (see below), so a user explicitly
# chooses whether to clean up lost atoms / their dangling bonds and continue.
# A fixed (non-shrink-wrap) box with margin keeps the neighbor bins bounded.

units           si
dimension       3
boundary        f f f
atom_style      bond
atom_modify     map array

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0
newton          on off
neighbor        0.0010 bin
comm_modify     cutoff 0.0030

lattice         sc 0.0005
region          box block -0.006 0.006 -0.006 0.002 -0.006 0.006 units box
region          target cylinder y 0.0 0.0 0.0050 -0.0050 0.0 units box
create_box      1 box bond/types 1 extra/bond/per/atom 130 extra/special/per/atom 150
create_atoms    1 region target

# nodal mass (density 2200 * nodal volume 1.25e-10) and nodal volume (the lone
# user-declared input)
mass            * 2.75e-7
fix             vol all property/atom d_vfrac d_damage ghost yes
set             group all d_vfrac 1.25e-10

# short-range contact between non-bonded near nodes
pair_style      bpm/peri
pair_coeff      * * 1.6863e22 0.0015001

# create the peridynamic bond set within the horizon, then restore special weights
create_bonds    many all all 1 0.0 0.0015001
special_bonds   lj 0.0 1.0 1.0 coul 1.0 1.0 1.0

bond_style      bpm/peri
#               model  K      G      lambda tau   horizon   s00    alpha
bond_coeff      1 ves 14.9e9 14.9e9 0.5 0.001 0.0015001 0.0005 0.25

velocity        all set 0.0 0.0 0.0 sum no units box
fix             1 all nve

# spherical indenter driven into the target to shatter it
variable        y0 equal 0.00155
variable        vy equal -100
variable        y equal "v_y0 + step*dt*v_vy"
fix             2 all indent 1e17 sphere 0.0000 v_y 0.0000 0.0015 units box

compute         dmg all property/atom d_damage
compute         davg all reduce ave f_dmg
timestep        1.0e-7
thermo          200
thermo_style    custom step atoms c_davg

# opt-in cleanup of shattered fragments (must follow thermo_style, which resets
# thermo_modify): drop atoms that leave the box and skip their now-dangling bonds
thermo_modify   lost ignore
thermo_modify   lost/bond ignore

#dump            1 all custom 200 dump.peri.ves id type x y z c_dmg
run             2000

# Generate data.ellipsoid-sparse: a lower-density, relaxed version of
# data.ellipsoid for the stiffer aspherical pair styles (e.g. resquared)
# that cannot tolerate the close ellipsoid contacts of the dense original
# (whose potential energy is ~5e9).  Deterministic, no RNG: expand the box
# to give the jammed pack room, then relax with viscous damping.
#   lmp -in in.relax-ellipsoid
units            lj
atom_style       ellipsoid
atom_modify      map array
read_data        data.ellipsoid
change_box       all x scale 1.4 y scale 1.4 z scale 1.4 remap
pair_style       resquared 4.0
pair_coeff       1 1     1.0 1.0 1 1 1 1 1 1
pair_coeff       1 2*3   1.0 1.0 1 1 1 1 1 1
pair_coeff       2*3 2*3 1.0 1.0 1 1 1 1 1 1
neigh_modify     delay 0 every 1 check yes
timestep         0.002
fix              1 all nve/asphere
fix              2 all viscous 1.0
run              2000
write_data       data.ellipsoid-sparse nocoeff

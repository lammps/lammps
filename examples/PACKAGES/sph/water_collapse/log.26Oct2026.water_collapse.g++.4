# the default number of steps is short for testing, use "-var nsteps 50000" to run until t=10
variable           nsteps index 2000

processors         * 1 1 # manually assign processors to spatial regions
atom_style         sph
dimension          2
newton             on
boundary           f f p
units              lj
read_data          data.initial

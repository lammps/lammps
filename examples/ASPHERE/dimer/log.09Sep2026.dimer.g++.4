# SRD diffusion demo - dimer particles

units           lj
atom_style      sphere
atom_modify     map array first big
dimension       2

# read in clusters of rigid bodies

fix             molprop all property/atom mol ghost yes
read_data       data.dimer fix molprop NULL Molecules

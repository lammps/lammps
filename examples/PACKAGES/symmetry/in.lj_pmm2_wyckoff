# fix symmetry example: 6 LJ atoms with two mirror planes (space group Pmm2)
#
# The group has 4 operators: identity, two-fold axis along z, and the
# mirror planes perpendicular to x and y.  Atoms 3 to 6 are on general
# positions and related by all 4 operators.  Atoms 1 and 2 are on the
# mirror plane y = 0, so each is its own image under the y mirror and
# they are images of each other under the x mirror and the two-fold
# axis: an orbit of 2 atoms for 4 operators.  Atoms 1 and 2 stay on the
# plane y = 0 and move as mirror images in x.

units           lj
atom_style      atomic
boundary        p p p
atom_modify     map array

region          box block 0 8 0 8 0 8
create_box      1 box

# atoms on the mirror plane y = 0
create_atoms    1 single 1.2 0.0 2.4
create_atoms    1 single 6.8 0.0 2.4
# atoms on general positions
create_atoms    1 single 1.0 1.5 3.0
create_atoms    1 single 7.0 6.5 3.0
create_atoms    1 single 7.0 1.5 3.0
create_atoms    1 single 1.0 6.5 3.0

mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
pair_modify     shift yes

fix             1 all nve
fix             sym all symmetry pmm2.json

velocity        all create 0.7 12345
run             0 post no
velocity        all scale 0.7

variable        y1 equal y[1]
variable        y2 equal y[2]
variable        sumx equal x[1]+x[2]

thermo_style    custom step temp pe etotal press v_y1 v_y2 v_sumx
thermo_modify   format float %14.8g
thermo          100
run             1000

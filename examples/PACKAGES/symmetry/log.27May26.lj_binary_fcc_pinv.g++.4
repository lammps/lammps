# Binary FCC L1_2-style LJ system constrained to P-1 inversion through
# the cell origin. The 256 atoms are split into 64 type-1 (corner
# sublattice) and 192 type-2 (face-centered sublattices) following the
# ordered Cu_3Au-like pattern. Since FCC sublattices are invariant under
# inversion, every orbit is "type-pure" (type-1 atoms pair with type-1,
# type-2 with type-2), so the existing P-1 operator works unchanged --
# the JSON differs from the single-type fcc_pinv.json only in the atom
# tag assignments. This example exercises fix symmetry on a multi-type
# system with non-trivial type-dependent LJ parameters.
#
# Companion files data.binary_fcc_pinv and binary_fcc_pinv.json are
# produced by generate_binary_fcc_pinv.py.

units           lj
atom_style      atomic
atom_modify     map array

read_data       data.binary_fcc_pinv
Reading data file ...
  orthogonal box = (0 0 0) to (6.3496 6.3496 6.3496)
  1 by 2 by 2 MPI processor grid
  reading atoms ...
  256 atoms
  read_data CPU = 0.001 seconds

pair_style      lj/cut 2.5
# type 1 = "host" (Cu-like): larger, deeper well
# type 2 = "guest" (Au-like): smaller, shallower well
# 1-2 cross interaction via simple geometric/arithmetic mixing
pair_coeff      1 1   1.0  1.0   2.5
pair_coeff      2 2   0.5  0.9   2.5
pair_coeff      1 2   0.7  0.95  2.5

neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no

velocity        all create 1.0 87287 loop geom

fix             1 all nve
fix             sym all symmetry binary_fcc_pinv.json

thermo          50
thermo_style    custom step temp pe etotal press

# Sanity checks: a type-1 inversion pair (tags 5, 13 -- both type 1, corner
# sublattice) and a type-2 inversion pair (tags 2, 62 -- both type 2,
# face-center sublattice) both preserve their (x_asym + x_image) mod L
# invariant. Picks below follow binary_fcc_pinv.json -- run the generator
# to inspect more.
variable        t1x equal (x[5]+x[13])/lx-round((x[5]+x[13])/lx)
variable        t1y equal (y[5]+y[13])/ly-round((y[5]+y[13])/ly)
variable        t1z equal (z[5]+z[13])/lz-round((z[5]+z[13])/lz)
variable        t2x equal (x[2]+x[62])/lx-round((x[2]+x[62])/lx)
variable        t2y equal (y[2]+y[62])/ly-round((y[2]+y[62])/ly)
variable        t2z equal (z[2]+z[62])/lz-round((z[2]+z[62])/lz)

print           "pre-run  type-1 pair residual=(${t1x},${t1y},${t1z})  type-2 pair residual=(${t2x},${t2y},${t2z})"
pre-run  type-1 pair residual=(0,0,0)  type-2 pair residual=(2.22044604925031e-16,2.22044604925031e-16,0)
run             250


+#ifndef LMP_METATENSOR_SYSTEM_H
+#define LMP_METATENSOR_SYSTEM_H
+
+#include <vector>
+#include <array>
+#include <unordered_set>
+
+#include "pointers.h"
+#include "pair.h"
+#include "neigh_list.h"
+

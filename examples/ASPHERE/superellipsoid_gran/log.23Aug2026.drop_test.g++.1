# Lattice wall drop test

units           si
atom_style      ellipsoid superellipsoid
dimension       3
boundary        p p f
comm_modify     vel yes
newton          off
processors      * * 1

neighbor 0.5 bin
neigh_modify   delay 0 every 1 check yes

# Setup Simulation Box
variable        box_length equal 9
variable        box_height equal 15

region          box block 0 ${box_length} 0 ${box_length} 0 ${box_height}
region          box block 0 9 0 ${box_length} 0 ${box_height}
region          box block 0 9 0 9 0 ${box_height}
region          box block 0 9 0 9 0 15
create_box      2 box
Created orthogonal box = (0 0 0) to (9 9 15)
  1 by 1 by 1 MPI processor grid

# Create Lattice Wall (Type 1)
lattice         sc 1.0
Lattice spacing in x,y,z = 1 1 1
region          floor_reg block 0 ${box_length} 0 ${box_length} 0 0.1
region          floor_reg block 0 9 0 ${box_length} 0 0.1
region          floor_reg block 0 9 0 9 0 0.1

variable        insertion_length equal ${box_length}-1.0
variable        insertion_length equal 9-1.0

create_atoms    1 region floor_reg
Created 81 atoms

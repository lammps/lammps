# tilt gravity: the heap stays at rest
# fix pour requires gravity along -z, and all bodies are inserted by now

variable     sx equal sin(${tilt}*PI/180.0)
variable     sx equal sin(20.0*PI/180.0)
variable     sz equal -cos(${tilt}*PI/180.0)
variable     sz equal -cos(20.0*PI/180.0)
unfix        ins
unfix        2
fix          2 all gravity 1.0 vector ${sx} 0.0 ${sz}
fix          2 all gravity 1.0 vector 0.342020143325669 0.0 ${sz}
fix          2 all gravity 1.0 vector 0.342020143325669 0.0 -0.939692620785908

run          ${steps_tilt}
run          10000

# Minimal non-covalent GFN2-xTB QM/MM example with 3-D PME.
#
# The two hydrogen atoms form the QM region.  The Na/Cl atom types are used
# only as classical point charges here; no short-range MM potential is
# included in this deliberately small smoke test.

units           real
atom_style      charge
atom_modify     map array
boundary        p p p

region          cell block 0 20 0 20 0 20 units box
create_box      3 cell
create_atoms    1 single 9.60 10.0 10.0 units box
create_atoms    1 single 10.40 10.0 10.0 units box
create_atoms    2 single 5.00 10.0 10.0 units box
create_atoms    3 single 15.00 10.0 10.0 units box

mass            1 1.008
mass            2 22.990
mass            3 35.450
set             atom 1 charge 0.0
set             atom 2 charge 0.0
set             atom 3 charge 1.0
set             atom 4 charge -1.0

group           qm id 1 2

# A separate Coulomb-only sub-style lets fix qmmm/xtb remove the classical
# real-space terms involving QM atoms without touching unrelated MM forces.
pair_style      coul/long 8.0
pair_coeff      * *
kspace_style    pppm/xtb 1.0e-5

fix             qmmm qm qmmm/xtb elements H Na Cl cutoff 8.0 method gfn2 charge 0 uhf 0

variable        q1 equal q[1]
variable        q2 equal q[2]
variable        fx1 equal fx[1]
variable        fx2 equal fx[2]
thermo_style    custom step pe f_qmmm v_q1 v_q2 v_fx1 v_fx2
thermo          1
run             0

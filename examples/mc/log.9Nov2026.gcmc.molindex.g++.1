# rigid SPC/E water model
pair_coeff      1 1 0.15535 3.166
pair_coeff      2 2 0.0000 0.0000

bond_coeff      1     0       1.0
angle_coeff     1     0       109.47

# rigid CO2 TraPPE model
pair_coeff      3   3  0.053649   2.8
pair_coeff      4   4  0.156973   3.05
bond_coeff      2       0       1.16
angle_coeff     2       0       180

# masses
# H2O
mass 1 15.9994
mass 2 1.0087
# CO2
mass 3 12.0107
mass 4 15.9994

# MD settings

group           h2o type 1 2
60 atoms in group h2o
group           co2 type 3 4
24 atoms in group co2
group           mobile union h2o co2
84 atoms in group mobile
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
velocity        all create ${temp} 54654 mom yes rot yes loop geom
velocity        all create 338.0 54654 mom yes rot yes loop geom
timestep        0.2500

# rigid constraints with thermostat

fix             myrigid all rigid/nvt/small molecule temp ${temp} ${temp} $(dt*100) mol mols
fix             myrigid all rigid/nvt/small molecule temp 338.0 ${temp} $(dt*100) mol mols
fix             myrigid all rigid/nvt/small molecule temp 338.0 338.0 $(dt*100) mol mols
fix             myrigid all rigid/nvt/small molecule temp 338.0 338.0 25 mol mols

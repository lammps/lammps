# vapor-liquid coexistence of CO2 (TraPPE model: rigid molecules with
# partial charges, long-range electrostatics) with Gibbs ensemble Monte Carlo
#
# requires two partitions, one for each box, e.g.:
#   mpirun -np 2 lmp -in in.gemc.co2 -partition 1 1
#   mpirun -np 4 lmp -in in.gemc.co2 -partition 1 3
#
# NIST saturated densities at 250 K: vapor 0.0466, liquid 1.046 g/cm^3
# molecules stay rigid, since all MC moves are rigid-body moves

variable        T index 250.0                # temperature (K)
variable        neq index 200                # equilibration cycles with step size tuning
variable        nprod index 1000             # production cycles
variable        rho world 0.05 0.9           # initial densities (g/cm^3)
variable        N world 40 216               # initial numbers of molecules
variable        L equal (v_N*44.0095/(0.60221408*v_rho))^(1.0/3.0)

units           real
atom_style      full
region          box block 0 ${L} 0 ${L} 0 ${L}
region          box block 0 38.811626088988 0 ${L} 0 ${L}
region          box block 0 38.811626088988 0 38.811626088988 0 ${L}
region          box block 0 38.811626088988 0 38.811626088988 0 38.811626088988
create_box      2 box bond/types 1 angle/types 1 extra/bond/per/atom 2                 extra/angle/per/atom 1 extra/special/per/atom 2
Created orthogonal box = (0 0 0) to (38.811626 38.811626 38.811626)
  1 by 1 by 1 MPI processor grid
molecule        co2mol CO2.txt
Read molecule template co2mol:
# CO2 molecule file. TraPPE model.
  1 molecules
  0 fragments
  0 bodies
  3 atoms with max type 2
  2 bonds with max type 1
  1 angles with max type 1
  0 dihedrals with max type 0
  0 impropers with max type 0
create_atoms    0 random ${N} 7771 NULL mol co2mol 464563 overlap 2.5 maxtry 1000
create_atoms    0 random 40 7771 NULL mol co2mol 464563 overlap 2.5 maxtry 1000
Created 120 atoms
  using lattice units in orthogonal box = (0 0 0) to (38.811626 38.811626 38.811626)
  create_atoms CPU = 0.002 seconds

pair_style      lj/cut/coul/long 12.0
pair_modify     mix arithmetic tail yes
kspace_style    pppm 1.0e-5
pair_coeff      1 1 0.053649 2.80
pair_coeff      2 2 0.156973 3.05
bond_style      harmonic
bond_coeff      1 0.0 1.16
angle_style     harmonic
angle_coeff     1 0.0 180.0
mass            1 12.0107
mass            2 15.9994
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# equilibration: every step attempt on average 50 molecule translations
# or rotations, 100 molecule exchanges, and 2 volume exchanges, and adjust
# the maximum displacement, rotation angle, and volume change

#   args:        N  M  X   V  T    displace maxdlogvolratio seed
fix             mc all gemc 1  50 100 2  ${T} 0.5      0.1             7771                 mol co2mol maxangle 30 tune 20 0.4 0.4
fix             mc all gemc 1  50 100 2  250.0 0.5      0.1             7771                 mol co2mol maxangle 30 tune 20 0.4 0.4
compute_modify  thermo_temp dynamic/dof yes

variable        nmol equal atoms/3
thermo_style    custom step v_nmol vol pe density f_mc[1] f_mc[2] f_mc[3]                 f_mc[4] f_mc[5] f_mc[6] f_mc[7] f_mc[8] f_mc[11]
thermo_modify   norm no
thermo          50
run             ${neq}
run             200

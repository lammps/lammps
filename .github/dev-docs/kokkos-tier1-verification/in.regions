include         common_lj.mod
region          rp plane 4 4 4 0 0 1 units box
region          rr prism 1 6 1 6 1 6 0.5 0.2 0.1 units box
region          rc cylinder z 4 4 3 1 7 units box
region          rk cone z 4 4 1 3 1 7 units box
region          re ellipsoid 4 4 4 3 2 2 units box
fix             1 all nve

fix             mygcmc gcmcgroup gcmc 1 100 100 1 29494 2 ${mu} ${disp}
fix             mygcmc gcmcgroup gcmc 1 100 100 1 29494 2 -1.25 ${disp}
fix             mygcmc gcmcgroup gcmc 1 100 100 1 29494 2 -1.25 1

# output

compute_modify  thermo_temp dynamic/dof yes
thermo_style    custom step temp press pe ke density atoms

# run equilibration and write restart

run             ${nequil}
run             100

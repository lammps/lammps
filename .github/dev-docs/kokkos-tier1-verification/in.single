include         mol_head.mod
variable        ps index lj/smooth/linear
if "${ps} == coul/slater/cut" then "pair_style ${ps} 1.0 9.0" "pair_coeff * *" &
elif "${ps} == lj/relres" "pair_style ${ps} 4.0 5.0 8.0 9.0" "pair_coeff * * 0.02 3.0 0.02 3.0" &
elif "${ps} == nm/cut/split" "pair_style ${ps} 9.0" "pair_coeff * * 0.02 3.0 9.0 6.0" &
elif "${ps} == lj/charmmfsw/coul/charmmfsh" "pair_style ${ps} 7.0 9.0" "pair_coeff * * 0.02 3.0" &
elif "${ps} == lj/sf" "pair_style ${ps} 9.0" "pair_coeff * * 0.02 3.0" &
else "pair_style ${ps} 9.0" "pair_coeff * * 0.02 3.0"
fix             1 all nve
thermo_style    custom step temp pe evdwl ecoul press
thermo          5
run             20 post no

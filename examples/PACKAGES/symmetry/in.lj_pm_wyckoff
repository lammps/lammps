# fix symmetry example: 3-atom LJ system in space group Pm with one atom
# on a Wyckoff special position (the y=L/2 mirror plane).
#
# Atoms 1 and 2 are a general-position pair related by the y-mirror.
# Atom 3 sits on the mirror plane at y = L/2; its motion in y is
# constrained by the fix's Lagrange-multiplier projection so that
# y_3 stays at L/2 to FP precision throughout the run.
#
# The companion file pm_wyckoff.json declares the 2-operator group and
# both orbits, with site_symmetry: [2] on the Wyckoff orbit.

units           lj
atom_style      atomic
boundary        p p p
atom_modify     map array

region          box block 0 8 0 8 0 8
create_box      1 box

# General-position pair (atoms 1 and 2 mirror each other in y).
create_atoms    1 single 1.2 2.5 3.0
create_atoms    1 single 1.2 5.5 3.0
# Wyckoff atom on the mirror plane (y = L/2 = 4.0).
create_atoms    1 single 1.5 4.0 2.0

mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0

velocity        all create 0.7 12345 mom yes rot yes

fix             1 all nve
fix             sym all symmetry pm_wyckoff.json

thermo          50
thermo_style    custom step temp pe etotal press

# Sanity checks: tag 3 stays on the mirror (y == 4.0) and tags 1+2 stay
# mirror-related (y1 + y2 == 8 = L).
variable        y3   equal y[3]
variable        sumy equal y[1]+y[2]

print           "pre-run  y3=${y3}   y1+y2=${sumy}   (must be 4 and 8)"
run             200
print           "post-run y3=${y3}   y1+y2=${sumy}   (must be 4 and 8)"

##############################################################################################
#### Atoms' types - mass - charge
##############################################################################################
#@ 8   atom types

variable Ba  equal 1
variable Zr  equal 2
variable  Y  equal 3 
variable O1  equal 4
variable O2  equal 5
variable O3  equal 6
variable H1  equal 7
variable O4  equal 8

##############################################################################################
#### Atoms' masses
##############################################################################################

mass  ${Ba}   137.327
mass  ${Zr}    91.224
mass  ${Y}     88.910
mass  ${O1}    15.996
mass  ${O2}    15.996
mass  ${O3}    15.996
mass  ${H1}     1.008
mass  ${O4}    15.996

##############################################################################################
#### Atoms' charges
##############################################################################################

set type ${Ba}  charge     2.000000 
set type ${Zr}  charge     4.000000 
set type ${Y}   charge     3.000000 
set type ${O1}  charge    -1.308698 
set type ${O2}  charge    -2.000000 
set type ${O3}  charge    -2.000000 
set type ${H1}  charge     0.308698 
set type ${O4}  charge    -1.308698 

##############################################################################################
#### Covalent bonds parameters                                                                
##############################################################################################
#@  2   bond types

bond_style harmonic
#@ O1 - H1
bond_coeff   1      23.008000      0.985357
#@ O4 - H1
bond_coeff   2      23.008000      0.985357

##############################################################################################
# Pair potentials                                                                             
##############################################################################################

variable rmin  equal  8.
variable rmax  equal 10.

pair_style hybrid/overlay buck/mdf ${rmin} ${rmax} lennard/mdf ${rmin} ${rmax} coul/long ${rmax} template/offset

##############################################################################################
# Buckingham interaction potentials
pair_coeff  ${Ba}  ${O1}  buck/mdf   688.21662   0.392014   0.000   
pair_coeff  ${Ba}  ${O2}  buck/mdf   972.19945   0.392014   0.000   
pair_coeff  ${Ba}  ${O3}  buck/mdf   972.19945   0.392014   0.000   
pair_coeff  ${Ba}  ${O4}  buck/mdf   688.21662   0.392014   0.000   
 
pair_coeff  ${Y}   ${O1}  buck/mdf   2972.3808   0.267317   0.000
pair_coeff  ${Y}   ${O2}  buck/mdf   4121.8373   0.280386   0.000
pair_coeff  ${Y}   ${O3}  buck/mdf   4121.8373   0.280386   0.000
pair_coeff  ${Y}   ${O4}  buck/mdf   2972.3808   0.267317   0.000

pair_coeff  ${Zr}  ${O1}  buck/mdf   2195.8712   0.298760   0.000
pair_coeff  ${Zr}  ${O2}  buck/mdf   3250.8545   0.298760   0.000
pair_coeff  ${Zr}  ${O3}  buck/mdf   3250.8545   0.298760   0.000
pair_coeff  ${Zr}  ${O4}  buck/mdf   2195.8712   0.298760   0.000
 
pair_coeff  ${O1}  ${O1}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O1}  ${O2}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O1}  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O1}  ${O4}  buck/mdf   22764.000   0.149000   0.000
 
pair_coeff  ${O2}  ${O2}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O2}  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O2}  ${O4}  buck/mdf   22764.000   0.149000   0.000

pair_coeff  ${O3}  ${O3}  buck/mdf   22764.000   0.149000   0.000
pair_coeff  ${O3}  ${O4}  buck/mdf   22764.000   0.149000   0.000

pair_coeff  ${O4}  ${O4}  buck/mdf   22764.000   0.149000   0.000

##############################################################################################
# 12-6 Lennard-Jones potentials
pair_coeff  ${O1}  ${H1}  lennard/mdf    6.391   0.000   
pair_coeff  ${O2}  ${H1}  lennard/mdf    6.391   0.000   
pair_coeff  ${O3}  ${H1}  lennard/mdf    7.800   0.000   
pair_coeff  ${O4}  ${H1}  lennard/mdf    6.391   0.000   

##############################################################################################
# Coulombic interaction
pair_coeff      *      *  coul/long

#########################################################################################################
# Parameters for reciprocal space electrostatics
#########################################################################################################

kspace_style pppm 1.0e-5
kspace_modify fftbench no 
# kspace_modify gewald 0.34497565

# Create a 2D chute flow and coarse-grain the resulting velocity field

units               lj
dimension           2
boundary            p m p
atom_style          sphere
comm_modify         vel yes

region              box block -5 5 0 25 -0.5 0.5
create_box          2 box

lattice             sq 2.0
region              box_trimmed block $(xlo+0.5) $(xhi-0.5) $(ylo+0.5) $(yhi-0.5) EDGE EDGE units box
create_atoms        1 region box_trimmed

set                 group all type/fraction 2 0.5 12393
group               t1 type 1
group               t2 type 2
set                 group t1 diameter 0.4
set                 group t2 diameter 0.6
velocity            all create 1e-6 325435 loop geom

pair_style          granular
pair_coeff          * * hertz 1 0.5 tangential linear_history 1.0 0.5 0.1

fix                 integrator all nve/sphere
fix                 grav all gravity 1e-5 chute 0
fix                 wall all wall/gran granular hooke 10.0 0.5 &
                             tangential linear_history 1.0 0.5 0.1 &
                             yplane 0.0 NULL contacts

timestep            0.05
thermo_style        custom step ke press vol pxx pyy pxy
thermo              1000

# dump                1 all custom 10000 atomDump id type radius x y z vx vy

run                 60000

variable            wall_contact atom f_wall[1]>0
group               newwall variable wall_contact
group               notwall subtract all newwall

run                 0

unfix               grav
unfix               integrator

fix                 integrator notwall nve/sphere
fix                 grav notwall gravity 1e-5 chute 20
fix                 wallc newwall freeze

compute             mybins notwall chunk/atom  bin/1d y center 0.5 units box
compute             ccont all continuum/chunk mybins 4.0 2.0 natoms velocity/x velocity/y
compute             cprop all property/chunk mybins count coord1
compute             vxmean all reduce ave vx
# fix                 ave all ave/time 1000 40 40000 c_cprop[*] c_ccont[*] mode vector file cg_fields.txt

variable            vxmax equal max(c_ccont[2])
variable            vxmin equal min(c_ccont[2])

thermo_style        custom step ke press vol pxx pyy pxy v_vxmin v_vxmax


run                 40000

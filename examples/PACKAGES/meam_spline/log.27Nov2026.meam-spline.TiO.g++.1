# the element names are assigned to the atom types in the order of the pair_coeff
# command: atom type 1 is O and atom type 2 is Ti, while the file lists Ti first
pair_style      meam/spline
pair_coeff      * * TiO.meam.spline O Ti
Reading meam/spline potential file TiO.meam.spline with DATE: 2016-06-05

neighbor        1.0 bin
neigh_modify    every 2 delay 0 check yes

thermo_style    custom step temp press pe ke etotal lx ly lz
thermo          25

# initial velocities for twice the target temperature.  they are assigned
# before the minimization, which does not change them, since "loop geom"
# derives them from the atom positions, and the relaxed positions can differ
# in the last digits with the number of MPI processes
velocity        all create 600.0 277387 loop geom

# relax the atom positions around the oxygen atoms
minimize        0.0 1.0e-4 1000 10000

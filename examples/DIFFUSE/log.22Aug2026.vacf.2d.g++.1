  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 3200 atoms
  using lattice units in orthogonal box = (0 0 -0.18257419) to (73.029674 73.029674 0.18257419)
  create_atoms CPU = 0.000 seconds

pair_style      lj/cut ${rc}
pair_style      lj/cut 2.5
pair_coeff      * * 1 1

mass            * 1.0
velocity        all create $t 97287 loop geom
velocity        all create 1 97287 loop geom

fix             1 all nve
fix             2 all langevin $t $t 0.1 498094
fix             2 all langevin 1 $t 0.1 498094
fix             2 all langevin 1 1 0.1 498094
fix             3 all enforce2d

# equilibration run

thermo          1000
run             5000

# 2D LJ mixture with a single hard wall at xhi; solute more strongly repelled
units          lj
dimension      2
boundary       p p p           # fixed in x,y; periodic in z (ignored in 2D)
atom_style     atomic
neigh_modify   delay 0 every 1

variable       x equal 20
variable       y equal 20
variable       rho equal 0.6
variable       t equal 1.0
variable       rc equal 2.5

# Wall parameters
variable       eps_hard equal 5.0    # solute-wall strength
variable       sigw     equal 1.0
variable       inLen   equal ${x}/1.5
variable       inLen   equal 20/1.5
variable       wall_x_lo   equal ${x}/2.0-${inLen}/2.0
variable       wall_x_lo   equal 20/2.0-${inLen}/2.0
variable       wall_x_lo   equal 20/2.0-13.3333333333333/2.0
variable       wall_x_hi   equal ${x}/2.0+${inLen}/2.0
variable       wall_x_hi   equal 20/2.0+${inLen}/2.0
variable       wall_x_hi   equal 20/2.0+13.3333333333333/2.0
variable       rcw      equal ${x}-${wall_x_hi}
variable       rcw      equal 20-${wall_x_hi}
variable       rcw      equal 20-16.6666666666667

# Problem setup
lattice        sq2 ${rho}
lattice        sq2 0.6
Lattice spacing in x,y,z = 1.8257419 1.8257419 1.8257419
region         simbox block 0 $x 0 $y -0.1 0.1
region         simbox block 0 20 0 $y -0.1 0.1
region         simbox block 0 20 0 20 -0.1 0.1

create_box     2 simbox
Created orthogonal box = (0 0 -0.18257419) to (36.514837 36.514837 0.18257419)
  2 by 2 by 1 MPI processor grid
create_atoms   1 box
Created 800 atoms
  using lattice units in orthogonal box = (0 0 -0.18257419) to (36.514837 36.514837 0.18257419)
  create_atoms CPU = 0.000 seconds

group          solvent type 1
800 atoms in group solvent
region         inVol block  ${wall_x_lo} ${wall_x_hi} 0 $y -0.1 0.1
region         inVol block  3.33333333333335 ${wall_x_hi} 0 $y -0.1 0.1
region         inVol block  3.33333333333335 16.6666666666667 0 $y -0.1 0.1
region         inVol block  3.33333333333335 16.6666666666667 0 20 -0.1 0.1
set            region inVol type/fraction 2 0.5 12393   # 50% solute
Setting atom values ...
  265 settings made for type/fraction
group          solute  type 2
265 atoms in group solute

mass           1 1.0
mass           2 1.0

pair_style     lj/cut ${rc}
pair_style     lj/cut 2.5
pair_coeff     1 1 1.0 1.0 ${rc}
pair_coeff     1 1 1.0 1.0 2.5
pair_coeff     1 2 1.0 1.0 ${rc}
pair_coeff     1 2 1.0 1.0 2.5
pair_coeff     2 2 1.0 1.0 ${rc}
pair_coeff     2 2 1.0 1.0 2.5


# Only one hard wall at xhi; no walls on xlo/ylo/yhi
print "Setting up walls at xhi=${wall_x_hi} ; xlo=${wall_x_lo} with eps=${eps_hard} and rc=${rcw}"
Setting up walls at xhi=16.6666666666667 ; xlo=3.33333333333335 with eps=5 and rc=3.3333333333333
fix            w2 solute  wall/harmonic/outside xlo ${wall_x_lo} ${eps_hard} ${sigw} ${rcw} xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic/outside xlo 3.33333333333335 ${eps_hard} ${sigw} ${rcw} xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic/outside xlo 3.33333333333335 5 ${sigw} ${rcw} xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic/outside xlo 3.33333333333335 5 1 ${rcw} xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic/outside xlo 3.33333333333335 5 1 3.3333333333333 xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic/outside xlo 3.33333333333335 5 1 3.3333333333333 xhi 16.6666666666667 ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic/outside xlo 3.33333333333335 5 1 3.3333333333333 xhi 16.6666666666667 5 ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic/outside xlo 3.33333333333335 5 1 3.3333333333333 xhi 16.6666666666667 5 1 ${rcw} pbc yes
fix            w2 solute  wall/harmonic/outside xlo 3.33333333333335 5 1 3.3333333333333 xhi 16.6666666666667 5 1 3.3333333333333 pbc yes

# Integration
velocity       all create ${t} 97287
velocity       all create 1 97287
fix            1 all nvt temp ${t} ${t} 0.1
fix            1 all nvt temp 1 ${t} 0.1
fix            1 all nvt temp 1 1 0.1

# Output
thermo         1000
thermo_style   custom step temp etotal press f_w2[1]

#dump           dmp all custom 5000 dump.wall.harmonic.outside.2d id type x y vx vy

group          solvent type 1
800 atoms in group solvent
region         inVol block  ${wall_x_lo} ${wall_x_hi} 0 $y -0.1 0.1
region         inVol block  10 ${wall_x_hi} 0 $y -0.1 0.1
region         inVol block  10 30 0 $y -0.1 0.1
region         inVol block  10 30 0 10 -0.1 0.1

variable       safe_x_lo   equal ${wall_x_lo}+1.0
variable       safe_x_lo   equal 10+1.0
variable       safe_x_hi   equal ${wall_x_hi}-1.0
variable       safe_x_hi   equal 30-1.0
region         inVolSafe block  ${safe_x_lo} ${safe_x_hi} 0 $y -0.1 0.1
region         inVolSafe block  11 ${safe_x_hi} 0 $y -0.1 0.1
region         inVolSafe block  11 29 0 $y -0.1 0.1
region         inVolSafe block  11 29 0 10 -0.1 0.1
set            region inVolSafe type/fraction 2 0.5 12393   # 50% solute
Setting atom values ...
  186 settings made for type/fraction
group          solute  type 2
186 atoms in group solute

mass           1 1.0
mass           2 1.0

pair_style     lj/cut ${rc}
pair_style     lj/cut 2.5
pair_coeff     1 1 1.0 1.0 ${rc}
pair_coeff     1 1 1.0 1.0 2.5
pair_coeff     1 2 1.0 1.0 ${rc}
pair_coeff     1 2 1.0 1.0 2.5
pair_coeff     2 2 1.0 1.0 ${rc}
pair_coeff     2 2 1.0 1.0 2.5


# Only one hard wall at xhi; no walls on xlo/ylo/yhi
print "Setting up walls at xhi=${wall_x_hi} ; xlo=${wall_x_lo} with eps=${eps_hard} and rc=${rcw}"
Setting up walls at xhi=30 ; xlo=10 with eps=5 and rc=2
fix            w2 solute  wall/harmonic xlo ${wall_x_lo} ${eps_hard} ${sigw} ${rcw} xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic xlo 10 ${eps_hard} ${sigw} ${rcw} xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic xlo 10 5 ${sigw} ${rcw} xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic xlo 10 5 1 ${rcw} xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic xlo 10 5 1 2 xhi ${wall_x_hi} ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic xlo 10 5 1 2 xhi 30 ${eps_hard} ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic xlo 10 5 1 2 xhi 30 5 ${sigw} ${rcw} pbc yes
fix            w2 solute  wall/harmonic xlo 10 5 1 2 xhi 30 5 1 ${rcw} pbc yes
fix            w2 solute  wall/harmonic xlo 10 5 1 2 xhi 30 5 1 2 pbc yes

# Integration
velocity       all create ${t} 97287
velocity       all create 1 97287
fix            1 all nvt temp ${t} ${t} 0.1
fix            1 all nvt temp 1 ${t} 0.1
fix            1 all nvt temp 1 1 0.1


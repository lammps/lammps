# Periodic three-body orbit in a periodic box with Ewald gravity (G = 1).
# The box side L sets the size of the periodic correction, ~ (r/L)^3.
#
# Runs 'Hill 3 months/yr' of R. J. Vanderbei, Ann. N.Y. Acad. Sci. 1017, 422 (2004)

variable L      index 10.0
variable dt     index 0.001
variable nsteps index 10000
variable every  index 100
variable thermo index 200

units           lj
atom_style      atomic
boundary        p p p
atom_modify     map array

read_data       data.hill3
Reading data file ...
  orthogonal box = (-5 -5 -5) to (5 5 5)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  3 atoms
  reading velocities ...
  3 velocities
  read_data CPU = 0.000 seconds
variable        h equal 0.5*${L}
variable        h equal 0.5*10.0
change_box      all x final -$h $h y final -$h $h z final -$h $h units box
change_box      all x final -5 $h y final -$h $h z final -$h $h units box
change_box      all x final -5 5 y final -$h $h z final -$h $h units box
change_box      all x final -5 5 y final -5 $h z final -$h $h units box
change_box      all x final -5 5 y final -5 5 z final -$h $h units box
change_box      all x final -5 5 y final -5 5 z final -5 $h units box
change_box      all x final -5 5 y final -5 5 z final -5 5 units box
Changing box ...
  orthogonal box = (-5 -5 -5) to (5 5 5)
  orthogonal box = (-5 -5 -5) to (5 5 5)
  orthogonal box = (-5 -5 -5) to (5 5 5)

# real-space cutoff scales with the box, G vector is chosen from the accuracy
variable        rc equal 0.4*${L}
variable        rc equal 0.4*10.0
pair_style      grav/long ${rc}
pair_style      grav/long 4
pair_coeff      * *
kspace_style    ewald/grav 1.0e-10

neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes

fix             1 all nve
timestep        ${dt}
timestep        0.001

thermo_style    custom step time pe ke etotal
thermo_modify   norm no format float %20.15g
thermo          ${thermo}
thermo          200

#dump            1 all custom ${every} traj.L${L}.dump id x y z
#dump_modify     1 sort id format float %.16g

run             ${nsteps}
run             10000

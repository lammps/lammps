# Periodic three-body orbit in a periodic box with Ewald gravity (G = 1).
# The box side L sets the size of the periodic correction, ~ (r/L)^3.
#
# Runs 'Hill 3 months/yr' of R. J. Vanderbei, Ann. N.Y. Acad. Sci. 1017, 422 (2004)

variable L      index 10.0
variable dt     index 0.001
variable nsteps index 10000
variable every  index 100
variable thermo index 200

units           lj
atom_style      atomic
boundary        p p p
atom_modify     map array

read_data       data.hill3
variable        h equal 0.5*${L}
change_box      all x final -$h $h y final -$h $h z final -$h $h units box

# real-space cutoff scales with the box, G vector is chosen from the accuracy
variable        rc equal 0.4*${L}
pair_style      grav/long ${rc}
pair_coeff      * *
kspace_style    ewald/grav 1.0e-10

neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes

fix             1 all nve
timestep        ${dt}

thermo_style    custom step time pe ke etotal
thermo_modify   norm no format float %20.15g
thermo          ${thermo}

#dump            1 all custom ${every} hill3.dump id x y z
#dump_modify     1 sort id format float %.16g

run             ${nsteps}

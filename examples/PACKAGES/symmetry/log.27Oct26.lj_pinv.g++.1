mass            1 1.0
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0
pair_modify     shift yes

fix             1 all nve
fix             sym all symmetry p-1.json

# random velocities are not symmetric.  "run 0" makes them symmetric,
# which removes about half of the kinetic energy, so the velocities are
# rescaled afterwards.  The temperature only counts the degrees of
# freedom left by the symmetry: here 3 for each of the 4 atom pairs.
velocity        all create 0.7 12345 mom yes rot yes
run             0 post no


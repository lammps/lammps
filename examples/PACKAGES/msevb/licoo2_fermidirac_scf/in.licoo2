units metal
atom_style full
boundary p p p

read_data data.licoo2_scf
change_box all triclinic

include ff.lmp

neigh_modify one 5000
molecule pre pre.mol
molecule post post.mol

fix evb all msevb &
  coupling none &
  reaction pre post react.map 2.86 &
  shells 1 &
  fermi_dirac 300.0 &
  scf_topology yes &
  file msevb.json every 1

fix_modify evb energy yes

fix nve all nve
fix tst all temp/csvr 300 300 0.1 12345
timestep 0.001
velocity all create 300.0 98765 mom yes dist gaussian
fix com all momentum 100 linear 1 1 1

variable p world 0 1 2 3 4 5 6

labelmap atom 1  Li 2  Co2 3   Co3 4  Co4 5  O 6  Co1
#dump all_dump all custom 1 all_dump.lammpstrj.${p} id typelabel x y z
#dump msevb_dump evb_atoms custom 1 msevb_dump.lammpstrj.${p} id typelabel x y z

thermo_style custom step temp pe ke etotal f_evb
thermo_modify flush yes
thermo 1

run 0

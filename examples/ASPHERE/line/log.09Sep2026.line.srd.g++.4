# delete overlaps
# must set 1-2 cutoff to non-zero value

pair_style      lj/cut  1.5
pair_coeff      1 1 1.0 1.0
pair_coeff      2 2 0.0 1.0 0.0
pair_coeff      1 2 1.0 1.0

delete_atoms    overlap 1.5 small big

# evaluate the reduced potential at 6 states along the decoupling path:
# lambda 1.0 -> 0.0 and charges shrinking to 0 in step, all with matching grids.
# state 1 is the fully-coupled (live) state, so c_MBAR[1] must equal the
# current pair energy (evdwl+ecoul+elong) divided by kB*T.

compute MBAR all mbar 300.0   pair lj/cut/coul/long/soft lambda * * 1.0 0.0 6   atom charge 1 0.1 0.0 6   atom charge 2 -0.1 0.0 6

# kB*T in real units (kcal/mol); consistency check should stay ~ 0
variable kT equal 0.0019872067*300.0
variable check equal "c_MBAR[1] - (evdwl+ecoul+elong)/v_kT"

thermo_style custom step etotal epair evdwl ecoul elong temp press   c_MBAR[1] c_MBAR[6] v_check
thermo 200

#dump TRAJ all custom 20 dump.lammpstrj id type element xu yu zu
#dump_modify TRAJ element C N

run 2000

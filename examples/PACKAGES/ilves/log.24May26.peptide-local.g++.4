# Solvated 5-mer peptide -- ILVES constraint solver, local variant
# (mirror of in.peptide-ilvesf using fix ilves/local; constrains only
#  water bonds + the HOH angle, which form 3-atom star clusters)

units           real
newton          on off    # newton bond OFF is required by fix ilves/local
atom_style      full

pair_style      lj/charmm/coul/long 8.0 10.0 10.0
bond_style      harmonic
angle_style     charmm
dihedral_style  charmm
improper_style  harmonic
kspace_style    pppm 0.0001

read_data       data.peptide

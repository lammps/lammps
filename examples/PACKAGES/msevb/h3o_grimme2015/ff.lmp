##############################################################################################
#### Atoms' types - mass - charge
##############################################################################################
#@ 4   atom types

variable O2  equal 1
variable H2  equal 2
variable O3  equal 3
variable H3  equal 4

##############################################################################################
#### Atoms' masses
##############################################################################################

mass  ${O2}    16.000
mass  ${H2}     1.010
mass  ${O3}    16.000
mass  ${H3}     1.010

##############################################################################################
#### Atoms' charges
##############################################################################################

set type ${O2}  charge    -0.820000 
set type ${H2}  charge     0.410000 
set type ${O3}  charge    -0.500000 
set type ${H3}  charge     0.500000 

##############################################################################################
#### Covalent bonds parameters                                                                
##############################################################################################
#@  2   bond types

bond_style hybrid harmonic morse
#@ O2 - H2
bond_coeff   1      harmonic       22.965000      1.0120000
#@ O3 - H3   
bond_coeff   2      morse           3.857600      2.1000000       1.0000000

##############################################################################################
#### Covalent angles parameters                                                               
##############################################################################################
#@  2   angle types

angle_style harmonic 
#@ H2 - O2 - H2  
angle_coeff   1      1.6456800      113.24000                              
#@ H3 - O3 - H3  
angle_coeff   2      1.6800000      111.72690


##############################################################################################
# Pair potentials                                                                             
##############################################################################################

variable rmin  equal 6.
variable rmax  equal 9.
variable rcoul equal 9.

pair_style hybrid/overlay coul/long ${rcoul} &
                             lj/cut ${rmax} &
                             lj/mdf ${rmin} ${rmax}

##############################################################################################
# Coulombic interaction
pair_coeff       *       *     coul/long
pair_coeff     ${O2}   ${O2}   lj/cut           0.00674000     3.16549200                 

# Hydronium
pair_coeff     ${O2}   ${O3}             lj/mdf      0.0053684      3.142
pair_coeff     ${O2}   ${H3}             lj/mdf      0.00010891     1.582746

special_bonds lj 0.0 0.0 0.0 coul 0.0 0.0 0.0

#########################################################################################################
# Parameters for reciprocal space electrostatics
#########################################################################################################

kspace_style pppm 1.0e-5
kspace_modify fftbench no 

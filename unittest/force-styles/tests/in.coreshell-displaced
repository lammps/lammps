variable  newton_pair     index  on
variable  newton_bond     index  on
variable  units           index  metal
variable  input_dir       index  .
variable  data_file       index ${input_dir}/data.coreshell-displaced
variable  pair_style      index 'zero 6.0'

atom_style       full
atom_modify      map array
neighbor         2.0 bin
neigh_modify     delay 2 every 2 check no
comm_modify      vel yes
units            ${units}
timestep         0.0005
newton           ${newton_pair} ${newton_bond}

pair_style       ${pair_style}
bond_style       harmonic

fix csinfo all property/atom i_CSID
read_data        ${data_file} fix csinfo NULL csinfo

bond_coeff 1 63.014 0.0
bond_coeff 2 25.724 0.0

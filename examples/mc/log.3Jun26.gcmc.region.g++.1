# GCMC for a LJ fluid confined to a spherical region inside the box.
#
# This input showcases the "region" keyword of fix gcmc: insertions,
# deletions, and Monte Carlo translation moves are all restricted to the
# named region (here a sphere in the center of the box).  For a
# non-rectangular region, trial positions are drawn from the region's
# rectangular bounding box and rejected until one falls inside the region.
#
# A translation move is also rejected if the displaced atom cannot be
# placed back inside the region within 1000 trials.  With the reasonable
# "disp" below this essentially never happens.  To see the
#   "Fix gcmc could not place a region-restricted trial move ..."
# warning fire reliably, comment out the first fix command below and
# uncomment the second one (displace = 1000.0 >> region size).  Because
# that warning is emitted only once per MPI rank, run on several ranks to
# see it multiple times, e.g.:
#
#   mpirun -np 4 lmp -in in.gcmc.region

# variables modifiable using the -var command line switch

variable        mu    index -1.25
variable        temp  index 2.0
variable        disp  index 1.0
variable        lbox  index 20.0

# global model settings

units           lj
atom_style      atomic
pair_style      lj/cut 3.0
pair_modify     tail no            # turn off to avoid triggering full_energy

# box

region          box block 0 ${lbox} 0 ${lbox} 0 ${lbox}
region          box block 0 20.0 0 ${lbox} 0 ${lbox}
region          box block 0 20.0 0 20.0 0 ${lbox}
region          box block 0 20.0 0 20.0 0 20.0
create_box      1 box
Created orthogonal box = (0 0 0) to (20 20 20)
  1 by 1 by 1 MPI processor grid

# spherical sub-region that confines all GCMC exchanges and moves

region          sphere sphere $(0.5*v_lbox) $(0.5*v_lbox) $(0.5*v_lbox) 6.0
region          sphere sphere 10 $(0.5*v_lbox) $(0.5*v_lbox) 6.0
region          sphere sphere 10 10 $(0.5*v_lbox) 6.0
region          sphere sphere 10 10 10 6.0

# lj parameters

pair_coeff      * * 1.0 1.0
mass            * 1.0

# dedicated group for the GCMC atoms

group           gcmcgroup type 1
0 atoms in group gcmcgroup

# region-restricted GCMC with reasonable settings

fix             mygcmc gcmcgroup gcmc 1 100 100 1 29494 ${temp} ${mu} ${disp} region sphere
fix             mygcmc gcmcgroup gcmc 1 100 100 1 29494 2.0 ${mu} ${disp} region sphere
fix             mygcmc gcmcgroup gcmc 1 100 100 1 29494 2.0 -1.25 ${disp} region sphere
fix             mygcmc gcmcgroup gcmc 1 100 100 1 29494 2.0 -1.25 1.0 region sphere

# ... variant that reliably triggers the region-placement warning.
# Uncomment the next line (and comment the one above), then run on
# multiple MPI ranks to see the one-time-per-rank warning several times:
#fix            mygcmc gcmcgroup gcmc 1 100 100 1 29494 ${temp} ${mu} 1000.0 region sphere

# atom count inside the region

variable        ninreg equal count(gcmcgroup,sphere)

# acceptance statistics

variable        nugget equal 1.0e-8
variable        tacc equal f_mygcmc[2]/(f_mygcmc[1]+${nugget})
variable        tacc equal f_mygcmc[2]/(f_mygcmc[1]+1e-08)
variable        iacc equal f_mygcmc[4]/(f_mygcmc[3]+${nugget})
variable        iacc equal f_mygcmc[4]/(f_mygcmc[3]+1e-08)
variable        dacc equal f_mygcmc[6]/(f_mygcmc[5]+${nugget})
variable        dacc equal f_mygcmc[6]/(f_mygcmc[5]+1e-08)

compute_modify  thermo_temp dynamic/dof yes
thermo_style    custom step atoms v_ninreg v_iacc v_dacc v_tacc press
thermo          100

# run

run             5000

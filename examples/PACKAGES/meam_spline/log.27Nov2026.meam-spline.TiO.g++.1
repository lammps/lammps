# oxygen interstitials in hcp titanium
#
# the potential in TiO.meam.spline was made for oxygen in the dilute limit,
# so the oxygen atoms are placed on octahedral sites far apart from each other

variable a equal 2.9305
variable ca equal 1.5964

units           metal
atom_style      atomic
boundary        p p p

# hcp titanium lattice with the c/a ratio of the potential
lattice         custom ${a} a1 1.0 0.0 0.0 a2 0.0 $(sqrt(3.0)) 0.0 a3 0.0 0.0 ${ca}                 basis 0.0 0.0 0.0 basis 0.5 0.5 0.0                 basis 0.5 $(5.0/6.0) 0.5 basis 0.0 $(1.0/3.0) 0.5
lattice         custom 2.9305 a1 1.0 0.0 0.0 a2 0.0 $(sqrt(3.0)) 0.0 a3 0.0 0.0 ${ca}                 basis 0.0 0.0 0.0 basis 0.5 0.5 0.0                 basis 0.5 $(5.0/6.0) 0.5 basis 0.0 $(1.0/3.0) 0.5
lattice         custom 2.9305 a1 1.0 0.0 0.0 a2 0.0 1.7320508075688771932 0.0 a3 0.0 0.0 ${ca}                 basis 0.0 0.0 0.0 basis 0.5 0.5 0.0                 basis 0.5 $(5.0/6.0) 0.5 basis 0.0 $(1.0/3.0) 0.5
lattice         custom 2.9305 a1 1.0 0.0 0.0 a2 0.0 1.7320508075688771932 0.0 a3 0.0 0.0 1.5964                 basis 0.0 0.0 0.0 basis 0.5 0.5 0.0                 basis 0.5 $(5.0/6.0) 0.5 basis 0.0 $(1.0/3.0) 0.5

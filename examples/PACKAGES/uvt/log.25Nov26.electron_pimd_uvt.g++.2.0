LAMMPS (13 Nov 2026)
Processor partition = 0
# Quadratic toy model regression for PIMD at constant potential.
#
# Launch this example with one partition per bead, e.g.
#
#   mpirun -np 2 lmp -partition 2x1 -in in.electron_pimd_uvt
#
# The electronic generalized coordinate Ne is coupled to
#
#   dE/dN = k * (Ne - N0)
#
# so the analytic equilibrium is
#
#   Ne* = N0 + mu/k

units           lj
atom_style      atomic
atom_modify     map yes
boundary        p p p

lattice         sc 0.7
Lattice spacing in x,y,z = 1.1262479 1.1262479 1.1262479
region          box block 0 2 0 2 0 2
create_box      1 box
Created orthogonal box = (0 0 0) to (2.2524958 2.2524958 2.2524958)
  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 8 atoms
  using lattice units in orthogonal box = (0 0 0) to (2.2524958 2.2524958 2.2524958)
  create_atoms CPU = 0.000 seconds

mass            1 1.0
pair_style      zero 2.5
pair_coeff      * *

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.002

# Give each bead a small initial offset to exercise the inter-partition path.
variable        beadshift universe 0.0 0.15
displace_atoms  all move ${beadshift} 0.0 0.0 units box
displace_atoms  all move 0.0 0.0 0.0 units box
Displacing atoms ...
velocity        all create 0.8 97531 mom yes rot no dist gaussian

variable        mu_target equal 1.5
variable        k_quad    equal 3.0
variable        N0_quad   equal 1.2
variable        Ne_init   equal 1.8
variable        Ne_target equal v_N0_quad + v_mu_target/v_k_quad
print           "Quadratic toy model target Ne* = ${Ne_target}"
Quadratic toy model target Ne* = 1.7

# Per-partition world id for partition-specific restart filenames.
# In a 2-bead PIMD run, partition 0 gets 0, partition 1 gets 1.
variable        worldid   universe 0 1

# For tchain 3, Ne, T_ins, Ne_dot, and bead dEdN are f_cp[11:14].
# These electronic outputs are global values and are not normalized by natoms.
variable        dEdN      equal v_k_quad*(f_cp[11]-v_N0_quad)

fix             cp all pimd/uvt method nmpimd thermostat NHC                 integrator obabo temp 0.8 Tdamp 0.2 tchain 3 tloop 1                 mu ${mu_target} Udamp 0.2 ne ${Ne_init}                 ne_velocity 0.0                 dedn v_dEdN
fix             cp all pimd/uvt method nmpimd thermostat NHC                 integrator obabo temp 0.8 Tdamp 0.2 tchain 3 tloop 1                 mu 1.5 Udamp 0.2 ne ${Ne_init}                 ne_velocity 0.0                 dedn v_dEdN
fix             cp all pimd/uvt method nmpimd thermostat NHC                 integrator obabo temp 0.8 Tdamp 0.2 tchain 3 tloop 1                 mu 1.5 Udamp 0.2 ne 1.8                 ne_velocity 0.0                 dedn v_dEdN

thermo          50
thermo_style    custom step temp etotal f_cp[11] f_cp[12] f_cp[13] f_cp[14] v_mu_target
thermo_modify   flush yes

run             1000


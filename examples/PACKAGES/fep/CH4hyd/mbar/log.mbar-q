# created by fftool

print "Methane in TIP4P water"
Methane in TIP4P water

units real
boundary p p p

atom_style full
bond_style harmonic
angle_style harmonic
special_bonds lj/coul 0.0 0.0 0.5

read_data data-mbar-lj.lmp

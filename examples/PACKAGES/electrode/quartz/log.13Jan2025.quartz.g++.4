group all type	1 2
1944 atoms in group all
group si type	2
648 atoms in group si
group o type	1
1296 atoms in group o
# -------------------------------------------------------- #
# ------------------ compute charges  -------------------- #
# -------------------------------------------------------- #
variable q atom q
compute qall all reduce sum v_q
compute qsi si reduce sum v_q
compute qo o reduce sum v_q
#
variable charge equal c_qall
variable charge_qsi equal c_qsi/count(si)
variable charge_qo equal c_qo/count(o)
# -------------------------------------------------------- #
thermo_style	custom step temp press etotal ke pe ecoul elong density v_charge_qsi v_charge_qo
thermo 100
timestep 1.0 #1 fs

# -------------------- ELECTRODE/QEQ --------------------- #
fix pra all property/atom d_chi d_hardness d_eta ghost yes
fix qeq all electrode/conp 0 algo cg 1e-4 symm on electronegativity d_chi hardness d_hardness eta d_eta
1944 atoms in group conp_group

# reciprocal width in 1/A
variable eta_Si equal 0.4738752
variable eta_O equal 0.8338071
# effective hardness in kcal/mol
variable hard_eff_Si equal 160.7282
variable hard_eff_O equal 308.0816
# hardness subtracted by the self-interaction
variable qqr2de equal 332.0637132991922
variable hard_Si equal ${hard_eff_Si}-${qqr2de}*sqrt(2/PI)*${eta_Si}
variable hard_Si equal 160.7282-${qqr2de}*sqrt(2/PI)*${eta_Si}
variable hard_Si equal 160.7282-332.063713299192*sqrt(2/PI)*${eta_Si}
variable hard_Si equal 160.7282-332.063713299192*sqrt(2/PI)*0.4738752
variable hard_O equal ${hard_eff_O}-${qqr2de}*sqrt(2/PI)*${eta_O}
variable hard_O equal 308.0816-${qqr2de}*sqrt(2/PI)*${eta_O}
variable hard_O equal 308.0816-332.063713299192*sqrt(2/PI)*${eta_O}
variable hard_O equal 308.0816-332.063713299192*sqrt(2/PI)*0.8338071
# set atom properties for fix electrode
set type 2 d_chi 96.11408 d_hardness ${hard_Si} d_eta ${eta_Si}  # Si
set type 2 d_chi 96.11408 d_hardness 35.1756718130579 d_eta ${eta_Si}  
set type 2 d_chi 96.11408 d_hardness 35.1756718130579 d_eta 0.4738752  

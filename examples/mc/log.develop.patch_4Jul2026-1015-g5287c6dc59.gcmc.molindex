  1 neighbor lists, perpetual/occasional/extra = 1 0 0
  (1) pair lj/cut/coul/long, perpetual
      attributes: half, newton on
      pair build: half/bin/newton
      stencil: half/bin/3d
      bin: standard

# rigid constraints with thermostat

fix             myrigid all rigid/nvt/small molecule temp ${temp} ${temp} $(dt*100) mol mols
fix             myrigid all rigid/nvt/small molecule temp 338.0 ${temp} $(dt*100) mol mols
fix             myrigid all rigid/nvt/small molecule temp 338.0 338.0 $(dt*100) mol mols
fix             myrigid all rigid/nvt/small molecule temp 338.0 338.0 25 mol mols
Fix rigid/nvt/small setup ...
  create bodies CPU = 0.000 seconds
  28 rigid bodies with 84 atoms
  1.16 = max distance from body owner to body atom

# dynamically update  fix rigid/nvt/small temperature ndof
fix_modify      myrigid dynamic/dof yes

# forcing MD engine to compute ndof
run             0

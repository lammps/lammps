# Coarse-grain polymer chains with near-linear backbone angles.

units           lj
atom_style      molecular
boundary        p p p

pair_style      lj/cut 4.0
bond_style      harmonic
angle_style     harmonic
read_data data.cg-polymers

neighbor        0.5 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.001
thermo          100
thermo_style    custom step temp press pe ke etotal

fix             cstr all ilves 1.0e-6 30 500 b 1 2 # a 1 2 linearangle 160 0.2
fix             move all npt temp 1.5 1.5 10.0 iso 1.0 1.0 100.0

run             3000

+#ifdef PAIR_CLASS
+// clang-format off
+PairStyle(metatensor/kk, PairMetatensorKokkos<LMPDeviceType>);
+// clang-format on
+#else
+
+#ifndef LMP_PAIR_METATENSOR_KOKKOS_H

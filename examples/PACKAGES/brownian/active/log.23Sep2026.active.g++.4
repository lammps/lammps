##### 2. Vicsek alignment, point particles with a neighbor cutoff of 1.5 #####

uncompute       msd
unfix           active
unfix           thermo

pair_style      zero 1.5
pair_coeff      * *

fix             thermo all langevin 0.0 0.0 1.0 48279
fix             active all active vicsek v0 1.0 Dr 0.5 Rcut 1.2 alignment 1.0 gamma 1.0 seed 54321

compute         vsum all reduce sum vx vy
variable        phi equal sqrt(c_vsum[1]^2+c_vsum[2]^2)/(count(all)*1.0)
thermo_style    custom step temp v_phi
thermo          500
run             2000

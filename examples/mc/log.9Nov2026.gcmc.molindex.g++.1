# gcmc
# MD steps need to be long for relaxation
variable        tfac equal 5.0/3.0 # (3 trans + 2 rot)/(3 trans)
## CO2 GCMC
fix             CO2gcmc co2 gcmc 1000 10 0 0 54341 ${temp} ${muco2} ${disp} mol                 mols molindex 2 tfac_insert ${tfac} group mobile rigid myrigid
fix             CO2gcmc co2 gcmc 1000 10 0 0 54341 338.0 ${muco2} ${disp} mol                 mols molindex 2 tfac_insert ${tfac} group mobile rigid myrigid
fix             CO2gcmc co2 gcmc 1000 10 0 0 54341 338.0 -8.30 ${disp} mol                 mols molindex 2 tfac_insert ${tfac} group mobile rigid myrigid
fix             CO2gcmc co2 gcmc 1000 10 0 0 54341 338.0 -8.30 0.5 mol                 mols molindex 2 tfac_insert ${tfac} group mobile rigid myrigid
fix             CO2gcmc co2 gcmc 1000 10 0 0 54341 338.0 -8.30 0.5 mol                 mols molindex 2 tfac_insert 1.66666666666667 group mobile rigid myrigid

## H2O GCMC
fix             H2Ogcmc h2o gcmc 1000 10 0 0 14345 ${temp} ${muh2o} ${disp} mol                 mols molindex 1 tfac_insert ${tfac} group mobile rigid myrigid
fix             H2Ogcmc h2o gcmc 1000 10 0 0 14345 338.0 ${muh2o} ${disp} mol                 mols molindex 1 tfac_insert ${tfac} group mobile rigid myrigid
fix             H2Ogcmc h2o gcmc 1000 10 0 0 14345 338.0 -8.0 ${disp} mol                 mols molindex 1 tfac_insert ${tfac} group mobile rigid myrigid
fix             H2Ogcmc h2o gcmc 1000 10 0 0 14345 338.0 -8.0 0.5 mol                 mols molindex 1 tfac_insert ${tfac} group mobile rigid myrigid
fix             H2Ogcmc h2o gcmc 1000 10 0 0 14345 338.0 -8.0 0.5 mol                 mols molindex 1 tfac_insert 1.66666666666667 group mobile rigid myrigid

# atom counts
variable        nh2o    equal count(h2o)/3
variable        nco2    equal count(co2)/3
variable        nmob    equal count(mobile)/3

# output
# CO2
variable        CO2tacc equal f_CO2gcmc[2]/(f_CO2gcmc[1]+0.1)
variable        CO2iacc equal f_CO2gcmc[4]/(f_CO2gcmc[3]+0.1)
variable        CO2dacc equal f_CO2gcmc[6]/(f_CO2gcmc[5]+0.1)
variable        CO2racc equal f_CO2gcmc[8]/(f_CO2gcmc[7]+0.1)
# H2o
variable        H2Otacc equal f_H2Ogcmc[2]/(f_H2Ogcmc[1]+0.1)
variable        H2Oiacc equal f_H2Ogcmc[4]/(f_H2Ogcmc[3]+0.1)
variable        H2Odacc equal f_H2Ogcmc[6]/(f_H2Ogcmc[5]+0.1)
variable        H2Oracc equal f_H2Ogcmc[8]/(f_H2Ogcmc[7]+0.1)

thermo_style    custom step temp press pe ke density atoms v_H2Oiacc v_H2Odacc v_H2Otacc v_H2Oracc v_CO2iacc v_CO2dacc v_CO2tacc v_CO2racc v_nh2o v_nco2 v_nmob
thermo          1000

# dump            mdump all custom 100 traj.lammpstrj id mol type xu yu zu

# run

run             30000

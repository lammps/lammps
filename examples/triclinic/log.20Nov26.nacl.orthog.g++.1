# orthogonal box for rock salt lattice with unit cell
# PPPM with per-atom energy and virial

units         lj
atom_style    charge

lattice       custom 0.72 a1 1.0 0.0 0.0 a2 0.0 1.0 0.0 a3 0.0 0.0 1.0               basis 0.0 0.0 0.0 basis 0.0 0.5 0.5 basis 0.5 0.0 0.5               basis 0.5 0.5 0.0 basis 0.5 0.0 0.0 basis 0.0 0.5 0.0               basis 0.0 0.0 0.5 basis 0.5 0.5 0.5

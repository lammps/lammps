# water box with AMOEBA: equal Ewald coefficients for the permanent
# multipoles and the induced dipoles, and the ASPC induced dipole predictor
#
# amoeba_water_box_equal.key sets pewald-alpha = ewald-alpha = 0.4 and
# polar-predict aspc; otherwise it is the same as amoeba_water_box.key.
# Step 0 reproduces in.water_box.amoeba (ewald-alpha 0.4, pewald-alpha 0.5)
# up to the Ewald convergence of the two settings.

units           real
boundary        p p p

atom_style      amoeba
bond_style      class2
angle_style     amoeba
dihedral_style  none

# per-atom properties required by AMOEBA or HIPPO

fix             amtype all property/atom i_amtype ghost yes
fix             extra all property/atom i_amgroup d_redID d_pval ghost yes
fix             extra2 all property/atom i_polaxe d2_xyzaxis 3

# read data file

read_data       data.water_box.amoeba fix amtype NULL "Tinker Types"
